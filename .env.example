# MongoDB Configuration
MONGO_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/your_db?appName=Cluster0
JWT_SECRET=your-secret-key-change-in-production
PORT=3001

# API Configuration (for frontend - only needed for local development)
# On Vercel, leave VITE_API_URL unset (the API is on the same domain)
VITE_API_URL=http://localhost:3001
